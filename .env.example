# ==============================================================================
# VLearn Hub & Spoke Tutor — Environment Variables Configuration
# ==============================================================================

# 1. Google Gemini API (Dành cho Next.js App trong codebase/web-demo & Benchmark Runner)
# Lấy key miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. NVIDIA NIM API (Dành cho Standalone Proxy Server node codebase/server.js)
# Lấy key tại: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi_your_nvidia_api_key_here
MODEL_NAME=meta/llama-3.2-11b-vision-instruct
PORT=3000
