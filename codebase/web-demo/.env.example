# VLearn Hub & Spoke Demo Environment Variables

# API Key for Gemini (Used by the local Next.js API Routes for Hub & Spoke bots)
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_ACTUAL_KEY_HERE"

# (Optional) Port configuration if you want to run on a specific port
# PORT=3000
